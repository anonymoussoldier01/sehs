{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node"
    },
    "client": {
      "root": "client",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "app" } },
    { "source": "/api", "destination": { "service": "app" } },
    { "source": "/open/:path*", "destination": { "service": "app" } },
    { "source": "/embed/:path*", "destination": { "service": "app" } },
    { "source": "/feed.xml", "destination": { "service": "app" } },
    { "source": "/admin/:path*", "destination": { "service": "app" } },
    { "source": "/admin", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
