{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/open/:path*", "destination": "/api/index.js" },
    { "source": "/embed/:path*", "destination": "/api/index.js" },
    { "source": "/feed.xml", "destination": "/api/index.js" },
    { "source": "/admin/:path*", "destination": "/api/index.js" }
  ]
}
