# Copy to .env (never commit .env). Keys are ONLY used by local ingestion scripts.
# PowerShell: $env:GEMINI_API_KEY="YOUR_KEY"; npm run ingest
GEMINI_API_KEY=
# Optional overrides:
# Gemini model for bulk enrichment (cheap/fast default)
GEMINI_MODEL=gemini-2.0-flash
# Drive API key — defaults to GEMINI_API_KEY if Drive API is enabled on same GCP project
DRIVE_API_KEY=
# Optional tuning
GEMINI_CONCURRENCY=3
GEMINI_BATCH_SIZE=5
HTTP_TIMEOUT_MS=15000
# Free AI tutor: Gemini is the primary provider (free key, generous quota).
# 1. Go to https://aistudio.google.com/ → Get API key (free, no credit card)
# 2. $env:GEMINI_AI_KEY="your-key"  (or add it to your real .env, never commit)
# Without a key the site still works via the keyless Pollinations fallback.
# GEMINI_AI_KEY=
# GEMINI_AI_MODEL=gemini-2.0-flash
# Pollinations anonymous fallback (no key or signup needed)
# AI_ENABLED=0 disables POST /api/ai/* entirely
# AI_ENABLED=1
# POLLINATIONS_BASE=https://text.pollinations.ai/openai
# POLLINATIONS_MODEL=openai-fast
