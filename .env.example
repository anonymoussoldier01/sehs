# Copy to .env (never commit .env). Keys are ONLY used by local ingestion scripts.
# PowerShell: $env:GEMINI_API_KEY="YOUR_KEY"; npm run ingest
GEMINI_API_KEY=
# Optional overrides:
# Gemini model for bulk enrichment (cheap/fast default)
GEMINI_MODEL=gemini-2.0-flash
# Drive API key — defaults to GEMINI_API_KEY if Drive API is enabled on same GCP project
DRIVE_API_KEY=
# Optional tuning
GEMINI_CONCURRENCY=3
GEMINI_BATCH_SIZE=5
HTTP_TIMEOUT_MS=15000
